# Demo runs without keys. Never commit .env or paste secrets in chat.
GOOGLE_API_KEY=
# Set a currently available Gemini model ID for your Google account.
GEMINI_MODEL=
EMBEDDING_MODEL=models/gemini-embedding-001
# Optional tracing sends redacted questions and tool excerpts to LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=advisoriq
# Recommended on a public live demo to restrict API use:
APP_USERNAME=
APP_PASSWORD=
HOST=127.0.0.1
PORT=7860
